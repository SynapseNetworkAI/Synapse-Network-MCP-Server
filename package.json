{
  "name": "@synapse-network/mcp-server",
  "version": "0.1.0",
  "description": "Stateless MCP server for SynapseNetwork agent runtime payments.",
  "type": "module",
  "bin": {
    "synapse-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "llm-instructions.md",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "smoke:cli": "node dist/index.js --help",
    "test:e2e:mock": "node scripts/e2e/mock.mjs",
    "test:e2e:local": "node scripts/e2e/live.mjs local",
    "test:e2e:staging": "node scripts/e2e/live.mjs staging",
    "test:e2e:prod": "node scripts/e2e/live.mjs prod",
    "ci:source-quality": "python3 scripts/ci/source_quality_checks_test.py && python3 scripts/ci/source_quality_checks.py",
    "ci:quality-budget": "node scripts/ci/quality_budget_check.test.mjs && node scripts/ci/quality_budget_check.mjs",
    "ci:quality": "npm run ci:source-quality && npm run ci:quality-budget",
    "verify:mcp": "npm run typecheck && npm test && npm run build && npm run test:e2e:mock"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "synapse-network",
    "agent-payments",
    "usdc"
  ],
  "license": "MIT",
  "author": "SynapseNetwork",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cliff-personal/Synapse-Network-MCP-Server.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "mcpName": "io.github.cliff-personal/synapse-network-mcp-server"
}
