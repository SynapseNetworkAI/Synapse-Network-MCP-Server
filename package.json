{
  "name": "@synapse-network-ai/mcp-server",
  "version": "0.1.5",
  "description": "Official Synapse Network MCP server for paid API calls and agent payments.",
  "type": "module",
  "bin": {
    "mcp-server": "dist/index.js",
    "synapse-mcp-server": "dist/index.js",
    "synapse-mcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "assets",
    "docs/launch",
    "skills",
    "README.md",
    "LAUNCHGUIDE.md",
    "LICENSE",
    "llms.txt",
    "llm-instructions.md",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "smoke:cli": "node dist/index.js --help",
    "test:e2e:mock": "node scripts/e2e/mock.mjs",
    "test:e2e:remote:mock": "npm run build && node scripts/e2e/remote-mock.mjs",
    "test:e2e:remote:openai": "node scripts/e2e/openai-remote-smoke.mjs",
    "test:e2e:remote:claude": "node scripts/e2e/claude-remote-smoke.mjs",
    "test:e2e:local": "node scripts/e2e/live.mjs local",
    "test:e2e:staging": "node scripts/e2e/live.mjs staging",
    "test:e2e:prod": "node scripts/e2e/live.mjs prod",
    "ci:source-quality": "python3 scripts/ci/source_quality_checks_test.py && python3 scripts/ci/source_quality_checks.py",
    "ci:quality-budget": "node scripts/ci/quality_budget_check.test.mjs && node scripts/ci/quality_budget_check.mjs",
    "ci:server-json": "node scripts/ci/server_json_check.mjs",
    "ci:directory-metadata": "node scripts/ci/directory_metadata_check.mjs",
    "ci:quality": "npm run ci:source-quality && npm run ci:quality-budget && npm run ci:server-json && npm run ci:directory-metadata",
    "start:http": "node dist/http.js",
    "deploy:gcloud:remote": "bash scripts/deploy/gcloud-remote-mcp.sh",
    "verify:mcp": "npm run typecheck && npm test && npm run build && npm run test:e2e:mock",
    "release:readiness": "npm run verify:mcp && npm run ci:quality && npm run smoke:cli && npm pack --dry-run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "synapse-network",
    "synapse-network-mcp",
    "synapsenetwork",
    "agentpay",
    "agent-payments",
    "ai-agent-payments",
    "crypto-micropayments",
    "usdc",
    "cursor",
    "claude-desktop",
    "claude-skills",
    "devin",
    "cursor-rules",
    "mcp-registry",
    "smithery",
    "pulsemcp",
    "glama",
    "openai-apps-sdk",
    "llms-txt"
  ],
  "license": "MIT",
  "author": "SynapseNetwork",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SynapseNetworkAI/Synapse-Network-MCP-Server.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jose": "^6.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "mcpName": "io.github.SynapseNetworkAI/synapse-network-mcp-server",
  "homepage": "https://www.synapse-network.ai/",
  "bugs": {
    "url": "https://github.com/SynapseNetworkAI/Synapse-Network-MCP-Server/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
